<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="life_secrets.xml" />
        <exclude domain="sharedpref" path="assistant_secrets.xml" />
        <!-- The speech model is downloaded again, and dictation audio is only kept until its text is saved. -->
        <exclude domain="external" path="models/" />
        <exclude domain="file" path="recordings/" />
        <exclude domain="file" path="voice/" />
        <!-- People (Network App until 2.5): its records and settings never leave the phone this way,
             as Network App kept them (it turned this backup off). PeopleStorageTest checks the list. -->
        <exclude domain="database" path="people.db" />
        <exclude domain="database" path="people.db-wal" />
        <exclude domain="database" path="people.db-shm" />
        <exclude domain="database" path="people.db-journal" />
        <exclude domain="sharedpref" path="people_save.xml" />
        <exclude domain="sharedpref" path="people_capture_draft.xml" />
        <exclude domain="sharedpref" path="people_checkin_settings.xml" />
        <exclude domain="sharedpref" path="people_assistant.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="life_secrets.xml" />
        <exclude domain="sharedpref" path="assistant_secrets.xml" />
        <exclude domain="external" path="models/" />
        <exclude domain="file" path="recordings/" />
        <exclude domain="file" path="voice/" />
        <!-- People (Network App until 2.5): its records and settings never leave the phone this way,
             as Network App kept them (it turned this backup off). PeopleStorageTest checks the list. -->
        <exclude domain="database" path="people.db" />
        <exclude domain="database" path="people.db-wal" />
        <exclude domain="database" path="people.db-shm" />
        <exclude domain="database" path="people.db-journal" />
        <exclude domain="sharedpref" path="people_save.xml" />
        <exclude domain="sharedpref" path="people_capture_draft.xml" />
        <exclude domain="sharedpref" path="people_checkin_settings.xml" />
        <exclude domain="sharedpref" path="people_assistant.xml" />
    </device-transfer>
</data-extraction-rules>
