<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Voice notes: the microphone, a foreground service that keeps recording with the screen off,
         and its notification. Speech becomes text on the phone; audio never leaves it. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Reminders at 08:00 and 20:00 from the life repo's list: on time even while the phone
         sleeps, and set again after a restart. USE_EXACT_ALARM is granted at install (Android 13+);
         Android 12 grants SCHEDULE_EXACT_ALARM by default. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- People (Network App until 2.5). A people-assistant turn waits tens of seconds on the gateway;
         without a foreground service the process is frozen the moment the user leaves the app, with
         the reply still in flight. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- People's check-in asks about numbers the user saves. Requested only when the user turns that
         on, and only names are read. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <queries>
        <!-- People's check-in answers come from Network App once, after Notes checks its signature. -->
        <package android:name="com.azizjon.network" />
    </queries>

    <application
        android:name=".NotesApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Notes">

        <!-- Single task, so a photo or text shared from another app, and People's evening check-in,
             land in the running app and its conversation rather than in a second copy of it. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Notes">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!-- Takes the check-in's answers from Network App once, app to app (CheckinHandover). It checks
             that the caller is Network App signed with its own key, so it is exported without a filter. -->
        <activity
            android:name=".people.checkin.CheckinHandoverActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service
            android:name=".people.ai.AiRequestService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- People's check-in: sees who wrote in Telegram, WhatsApp, KakaoTalk and LinkedIn, once the
             user grants notification access. Only the system can bind it. -->
        <service
            android:name=".people.checkin.ChatNotificationListener"
            android:exported="true"
            android:label="@string/chat_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".reminders.ReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".voice.RecordingService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
